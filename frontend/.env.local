# ── Mock mode ─────────────────────────────────────────────────────
# Set to "true" for local dev without contracts. Set to "false" when live.
NEXT_PUBLIC_MOCK=true

# ── WalletConnect ─────────────────────────────────────────────────
NEXT_PUBLIC_WC_PROJECT_ID=demo

# ── Chain IDs ─────────────────────────────────────────────────────
# Contracts + 1inch Aqua + SwapVM + Chainlink CRE → Ethereum Sepolia
NEXT_PUBLIC_SEPOLIA_CHAIN_ID=11155111

# Arkiv data schemas → Rabdi testnet (separate chain, NOT Sepolia)
NEXT_PUBLIC_RABDI_CHAIN_ID=7794095
NEXT_PUBLIC_RABDI_RPC=https://rpc.rabdi.db-chain.testnet.arkiv.network

# ── Contract addresses (fill in after Sepolia deploy) ─────────────
NEXT_PUBLIC_PARLAY_ROUTER=0x0000000000000000000000000000000000000001
NEXT_PUBLIC_PARLAY_VAULT=0x0000000000000000000000000000000000000002
NEXT_PUBLIC_MARKET_RESOLVER=0x0000000000000000000000000000000000000003
NEXT_PUBLIC_MOCK_USDC=0x0000000000000000000000000000000000000004

# 1inch Aqua on Sepolia — from Watermark (3rd, Tokyo) + Takarabako (2nd, Continuity).
# Same deterministic address as mainnet. Confirm at booth before relying on it.
NEXT_PUBLIC_AQUA_ADDRESS=0x1111113ccf1426a8e30e2bff5e005d929bf6a90a

# SwapVM router on Sepolia (v1.0.2) — Takarabako used this.
# Ask booth: "Is this still the right router version for the Aqua above?"
NEXT_PUBLIC_AQUA_ROUTER=0x1111113db0e0ef9d0e3a50d5f094a3a57a26c0de

# ── Arkiv wallet constants (fill in after key setup) ───────────────
# TRUSTED_WALLET = your deployer wallet (markets + desks filtered by owner)
# ORACLE_RELAYER = wallet Chainlink CRE uses to write results (never trust results from other owners)
NEXT_PUBLIC_TRUSTED_WALLET=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_ORACLE_RELAYER=0x0000000000000000000000000000000000000000
